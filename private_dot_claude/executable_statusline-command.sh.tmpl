#!/bin/bash
# Statusline Claude Code - couleurs générées depuis la palette jelly (chezmoi)
input=$(cat)

model=$(echo "$input" | jq -r '.model.display_name // "unknown"' | sed -E 's/ *\(.*\)$//')
cwd=$(echo "$input" | jq -r '.workspace.current_dir // .cwd // ""')
dir=$(basename "$cwd")
transcript_path=$(echo "$input" | jq -r '.transcript_path // empty')
context_window_size=$(echo "$input" | jq -r '.context_window.context_window_size // empty')
effort=$(echo "$input" | jq -r '.effort.level // empty')
weekly_pct=$(echo "$input" | jq -r '.rate_limits.seven_day.used_percentage // empty')
session_pct=$(echo "$input" | jq -r '.rate_limits.five_hour.used_percentage // empty')
session_id=$(echo "$input" | jq -r '.session_id // empty')

# Palette jelly -> SGR truecolor
c() { printf -v "$1" '\033[38;2;%d;%d;%dm' "0x${2:1:2}" "0x${2:3:2}" "0x${2:5:2}"; }
c TEAL   '{{ .jelly.teal }}'
c YELLOW '{{ .jelly.yellow }}'
c BLUE   '{{ .jelly.blue }}'
c LBLUE  '{{ .jelly.lblue }}'
c ORANGE '{{ .jelly.orange }}'
c RED    '{{ .jelly.red }}'
c PURP   '{{ .jelly.purp }}'
c LGREEN '{{ .jelly.lgreen }}'
c FG1    '{{ .jelly.fg1 }}'
c BASE5  '{{ .jelly.base5 }}'
c BASE4  '{{ .jelly.base4 }}'
RESET=$'\033[0m'

# Raw hex (no escape) for gradient interpolation between LGREEN and RED
LGREEN_HEX='{{ .jelly.lgreen }}'
RED_HEX='{{ .jelly.red }}'

# Truecolor interpolated between LGREEN (0%) and RED (100%), stepped every 10%
gradient_color() {
  local pct=$1 step t r1 g1 b1 r2 g2 b2 r g b
  step=$(( pct / 10 )); [ "$step" -gt 10 ] && step=10
  t=$(awk "BEGIN { printf \"%.4f\", $step / 10 }")
  r1=$((16#${LGREEN_HEX:1:2})); g1=$((16#${LGREEN_HEX:3:2})); b1=$((16#${LGREEN_HEX:5:2}))
  r2=$((16#${RED_HEX:1:2}));    g2=$((16#${RED_HEX:3:2}));    b2=$((16#${RED_HEX:5:2}))
  r=$(awk "BEGIN { printf \"%d\", $r1 + ($r2 - $r1) * $t }")
  g=$(awk "BEGIN { printf \"%d\", $g1 + ($g2 - $g1) * $t }")
  b=$(awk "BEGIN { printf \"%d\", $b1 + ($b2 - $b1) * $t }")
  printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"
}

# Git branch (skip optional locks)
branch=$(git -C "$cwd" symbolic-ref --short HEAD 2>/dev/null)

# Lignes +/- vs main (commits + non commité + fichiers non suivis), code et commentaires séparés.
# Commentaire = ligne commençant par // # /* * -- <!-- (heuristique), ou toute ligne d'un .md
diff_seg=""
if [ -n "$branch" ] && root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) \
  && base=$(git -C "$root" merge-base main HEAD 2>/dev/null); then
  read -r add del cadd cdel < <(cd "$root" && {
    git diff -U0 "$base"
    git ls-files -oz --exclude-standard | xargs -0 -n1 git diff --no-index -U0 /dev/null
  } 2>/dev/null | awk '
    /^diff --git/ { md = $NF ~ /\.(md|mdx)$/; hdr = 1; next }
    /^@@/ { hdr = 0; next }
    hdr || !/^[+-]/ { next }
    { s = substr($0, 2); sub(/^[ \t]+/, "", s)
      n[substr($0, 1, 1) (md || s ~ /^(\/\/|\/\*|<!--|--|#([^[!]|$)|\*([ \/]|$))/ ? "c" : "")]++ }
    END { print n["+"] + 0, n["-"] + 0, n["+c"] + 0, n["-c"] + 0 }')
  # script() <chiffres> <+> <-> : code en exposant, commentaires en indice
  script() { local s=$1 d=($2) i; for i in {0..9}; do s=${s//$i/${d[i]}}; done; s=${s//+/$3}; printf '%s' "${s//-/$4}"; }
  (( add || del )) && diff_seg=$(script "+${add}-${del}" '⁰ ¹ ² ³ ⁴ ⁵ ⁶ ⁷ ⁸ ⁹' ⁺ ⁻)
  (( cadd || cdel )) && diff_seg+=$(script "+${cadd}-${cdel}" '₀ ₁ ₂ ₃ ₄ ₅ ₆ ₇ ₈ ₉' ₊ ₋)
fi

# GitLab MR for the current branch (cached + refreshed in background to keep render fast)
mr_iid=""
mr_url=""
if [ -n "$branch" ] && command -v glab >/dev/null 2>&1; then
  cache_dir="${TMPDIR:-/tmp}/claude-statusline-mr"
  mkdir -p "$cache_dir" 2>/dev/null
  cache_key=$(printf '%s\n%s' "$cwd" "$branch" | cksum | cut -d' ' -f1)
  cache_file="$cache_dir/$cache_key"
  refresh=1
  if [ -f "$cache_file" ]; then
    mtime=$(stat -f %m "$cache_file" 2>/dev/null || stat -c %Y "$cache_file" 2>/dev/null || echo 0)
    age=$(( $(date +%s) - mtime ))
    [ "$age" -lt 120 ] && refresh=0
  fi
  if [ "$refresh" -eq 1 ]; then
    # Non-blocking refresh: write the latest open MR (iid<TAB>url) for this branch.
    ( cd "$cwd" 2>/dev/null && glab mr list --source-branch "$branch" -F json 2>/dev/null \
        | jq -r '.[0] | select(.iid) | "\(.iid)\t\(.web_url)"' > "$cache_file.tmp" 2>/dev/null \
        && mv "$cache_file.tmp" "$cache_file" 2>/dev/null ) >/dev/null 2>&1 &
  fi
  if [ -f "$cache_file" ]; then
    mr_iid=$(cut -f1 "$cache_file" 2>/dev/null)
    mr_url=$(cut -f2 "$cache_file" 2>/dev/null)
  fi
fi

fmt_tokens() { awk "BEGIN { n=$1; if (n >= 1000000) { v = n / 1000000; printf (v == int(v) ? \"%dm\" : \"%.1fm\"), v } else if (n >= 1000) { v = n / 1000; printf (v == int(v) ? \"%dk\" : \"%.1fk\"), v } else printf \"%d\", n }"; }

# Context window usage from transcript: used tokens (last turn) vs window size
used_int=""
used_fmt=""
window_fmt=""
if [ -n "$transcript_path" ] && [ -n "$context_window_size" ] && [ -f "$transcript_path" ] && [ "$context_window_size" -gt 0 ] 2>/dev/null; then
  used_tokens=$(jq -s 'map(select(.message.usage and .isSidechain != true and .isApiErrorMessage != true)) | last | if . then (.message.usage.input_tokens // 0) + (.message.usage.cache_read_input_tokens // 0) + (.message.usage.cache_creation_input_tokens // 0) else 0 end' < "$transcript_path" 2>/dev/null)
  if [ -n "$used_tokens" ] && [ "$used_tokens" -gt 0 ] 2>/dev/null; then
    used_int=$(awk "BEGIN { printf \"%d\", ($used_tokens / $context_window_size) * 100 }")
    used_fmt=$(fmt_tokens "$used_tokens")
    window_fmt=$(fmt_tokens "$context_window_size")
  fi
fi

# Quota gauges, filling left to right (empty = 0%, full = 100%), separated by a dash:
# weekly (rate_limits.seven_day) as a moon phase, session (rate_limits.five_hour) as a pie slice
MOONS=(              )
SLICES=(󰄰 󰪞 󰪟 󰪠 󰪡 󰪢 󰪣 󰪤 󰪥)
out=""
if [ -n "$session_pct" ]; then
  sp=$(awk "BEGIN { printf \"%d\", $session_pct }")
  [ "$sp" -gt 100 ] && sp=100
  out="${BASE4}${SLICES[$(( sp * (${#SLICES[@]} - 1) / 100 ))]}${RESET}"
fi
if [ -n "$weekly_pct" ]; then
  wp=$(awk "BEGIN { printf \"%d\", $weekly_pct }")
  [ "$wp" -gt 100 ] && wp=100
  [ -n "$out" ] && out="${out}${BASE4}-${RESET}"
  out="${out}$(gradient_color "$wp")${MOONS[$(( wp * (${#MOONS[@]} - 1) / 100 ))]}${RESET}"
fi
[ -n "$out" ] && out="${out} "

# Remote Control actif : le registre de session porte bridgeSessionId tant que /rc est connecte
rc=""
if [ -n "$session_id" ]; then
  rc=$(jq -r --arg sid "$session_id" 'select(.sessionId == $sid and .bridgeSessionId) | "1"' "$HOME"/.claude/sessions/*.json 2>/dev/null | head -1)
fi
[ -n "$rc" ] && out="${LBLUE}󰄡${RESET}  ${out}"

# Build output
out="${out}${TEAL}${model}${RESET}"

# Reasoning effort if available (absent when model doesn't support it)
if [ -n "$effort" ]; then
  case "$effort" in
    low)       ecolor=$LGREEN ;;
    medium)    ecolor=$YELLOW ;;
    high)      ecolor=$ORANGE ;;
    xhigh|max) ecolor=$RED ;;
    *)         ecolor=$LBLUE ;;
  esac
  out="${out} ${ecolor}${effort}${RESET}"
fi

# Directory
out="${out} ${FG1}󰉖 ${dir}${RESET}"

# Git branch if present
[ -n "$branch" ] && out="${out} ${PURP}⎇ (${branch})${diff_seg:+ ${BASE4}${diff_seg}}${RESET}"

# GitLab MR badge (clickable via OSC 8 hyperlink, BEL-terminated)
if [ -n "$mr_iid" ]; then
  if [ -n "$mr_url" ]; then
    out="${out} ${BLUE}⛙ $(printf '\033]8;;%s\007MR !%s\033]8;;\007' "$mr_url" "$mr_iid")${RESET}"
  else
    out="${out} ${BLUE}⛙ MR !${mr_iid}${RESET}"
  fi
fi

# Context window usage: used/total (percentage), color gradient stepped every 10%
if [ -n "$used_fmt" ]; then
  gcolor=$(gradient_color "$used_int")
  out="${out} ${gcolor}⛁ ${used_fmt}/${window_fmt} (${used_int}%)${RESET}"
fi

printf '%s' "$out"
