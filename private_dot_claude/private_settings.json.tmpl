{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "additionalDirectories": [
      "{{ .chezmoi.homeDir }}/Code/murmure/metacognition"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "ponytail@ponytail": true,
    "humanizer@humanizer": true,
    "typescript-lsp@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "mur-release@murmure-marketplace": true,
    "svelte@svelte": true,
    "frontend-design@anthropic-plugin-directory": true,
    "cc-plugin-you-should-know@builtin": true,
    "mur-metacognition@murmure-marketplace": true,
    "o11y@fondation-marketplace": true,
    "atlassian-mcp@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "murmure-marketplace": {
      "source": {
        "source": "git",
        "url": "git@gitlab.dnm.radiofrance.fr:murmure/claude-marketplace.git"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools"
      }
    },
    "fondation-marketplace": {
      "source": {
        "source": "git",
        "url": "git@gitlab.dnm.radiofrance.fr:struktur/claude-marketplace.git"
      },
      "autoUpdate": true
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "opus",
  "remote": {
    "defaultEnvironmentId": "env_01TnRz7J8yu9MtF5XDCKhQYa"
  },
  "theme": "custom:jelly",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(kubectl delete:*) — pending explicit confirmation for destructive cluster ops",
      "Bash(glab mr merge:*) — merge-without-review risk"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: RadioFrance (gitlab.dnm.radiofrance.fr)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Default / protected branches**: main is default; do not modify main directly — always branch from an updated main",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Trusted internal domains**: gitlab.dnm.radiofrance.fr",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries prod or production as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries prod or production as a whole word or name segment",
      "### User-specific",
      "**Org-specific CLIs**: glab (GitLab CLI), rtk, kubectl, chezmoi"
    ]
  },
  "model": "opus"
}
